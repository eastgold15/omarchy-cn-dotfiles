#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FAILURES=0
WARNINGS=0

ok() { printf '\033[1;32m[ok]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; WARNINGS=$((WARNINGS + 1)); }
fail() { printf '\033[1;31m[fail]\033[0m %s\n' "$*" >&2; FAILURES=$((FAILURES + 1)); }

usage() {
  cat <<'EOF'
Usage: ./check [all|mise|lazygit|yazi|hypr|git-identity|security] [...]
EOF
}

validate_toml() {
  local file="$1"

  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import pathlib, sys, tomllib; tomllib.loads(pathlib.Path(sys.argv[1]).read_text())' "$file"
  else
    warn "python3 is unavailable; skipped TOML parsing for $file"
  fi
}

check_lazygit() {
  local config="$ROOT/config/lazygit/config.yml"
  [[ -s "$config" ]] || {
    fail "Missing Lazygit config"
    return
  }

  if command -v lazygit >/dev/null 2>&1; then
    if lazygit --use-config-file "$config" --config >/dev/null; then
      ok "Lazygit accepts config.yml"
    else
      fail "Lazygit rejected config.yml"
    fi
  else
    warn "lazygit is unavailable; skipped application-level validation"
  fi
}

check_yazi() {
  local file
  for file in "$ROOT/config/yazi/yazi.toml" "$ROOT/config/yazi/keymap.toml"; do
    if [[ ! -s "$file" ]]; then
      fail "Missing Yazi config: $file"
    elif validate_toml "$file"; then
      ok "Valid TOML: ${file#"$ROOT/"}"
    else
      fail "Invalid TOML: ${file#"$ROOT/"}"
    fi
  done

  # Yazi 26+ removed --debug and requires a TTY even for --help, so there is
  # no headless way to have it validate the config. TOML validation above is
  # all we can do here.
  if ! command -v yazi >/dev/null 2>&1; then
    warn "yazi is not installed; run ./install packages before using this module"
  fi
}

check_mise() {
  local config="$ROOT/config/mise/config.toml"
  local tool
  local required_tools=(
    ast-grep
    bun
    claude
    codex
    gh
    go
    java
    node
    pi
    uv
  )

  [[ -s "$config" ]] || {
    fail "Missing global mise configuration"
    return
  }
  if validate_toml "$config"; then
    ok "Valid TOML: config/mise/config.toml"
  else
    fail "Invalid global mise configuration"
    return
  fi

  for tool in "${required_tools[@]}"; do
    if ! python3 - "$config" "$tool" <<'PY'
import pathlib
import sys
import tomllib

tools = tomllib.loads(pathlib.Path(sys.argv[1]).read_text()).get("tools", {})
raise SystemExit(0 if sys.argv[2] in tools else 1)
PY
    then
      fail "Global mise configuration is missing '$tool'"
    fi
  done

  grep -Eq '^[[:space:]]+bootstrap\) install_bootstrap ;;$' "$ROOT/install" ||
    fail "Installer does not expose the one-command bootstrap module"
  grep -q '^  install_linked_config mise$' "$ROOT/install" ||
    fail "Tools installation does not deploy the global mise configuration"
  grep -q '^    mise install$' "$ROOT/install" ||
    fail "Tools installation does not install the declared mise tools"
  ok "Global mise tool configuration is complete"
}

check_hypr() {
  local file="$ROOT/config/hypr/input.lua"

  [[ -s "$file" ]] || {
    fail "Missing Hyprland input configuration"
    return
  }

  local lua_file found=0
  for lua_file in "$ROOT/config/hypr/"*.lua; do
    [[ -f "$lua_file" ]] || continue
    found=1
    if command -v luac >/dev/null 2>&1; then
      if luac -p "$lua_file" 2>/dev/null; then
        ok "Valid Lua syntax: ${lua_file#"$ROOT/"}"
      else
        fail "Invalid Lua syntax: ${lua_file#"$ROOT/"}"
      fi
    else
      warn "luac is unavailable; skipped Lua syntax validation for ${lua_file#"$ROOT/"}"
    fi
  done
  (( found )) || fail "No Hyprland Lua configuration found"

  local script
  for script in "$ROOT/config/hypr/scripts/"*.sh; do
    [[ -f "$script" ]] || continue
    if bash -n "$script"; then
      ok "Valid Bash syntax: ${script#"$ROOT/"}"
    else
      fail "Invalid Bash syntax: ${script#"$ROOT/"}"
    fi
  done

  grep -q 'input.keyboard.key' "$file" ||
    fail "Hyprland input configuration does not monitor keyboard events"
  grep -q 'fcitx5-remote -t' "$file" ||
    fail "Hyprland input configuration does not toggle Fcitx5"
  grep -q 'local left_shift_keycode = 50' "$file" ||
    fail "Hyprland input configuration does not identify left Shift"
  ok "Hyprland input configuration is valid"
}

check_git_identity() {
  local script="$ROOT/bin/git-identity"

  [[ -x "$script" ]] || {
    fail "Git identity setup script is missing or not executable"
    return
  }
  if bash -n "$script"; then
    ok "Git identity setup script has valid Bash syntax"
  else
    fail "Git identity setup script has invalid Bash syntax"
  fi
  grep -q -- '--quick-generate-key' "$script" ||
    fail "Git identity setup cannot generate an OpenPGP key"
  grep -q -- '--list-secret-keys' "$script" ||
    fail "Git identity setup does not validate local secret keys"
  grep -q -- '--export-public-key' "$script" ||
    fail "Git identity setup cannot export the configured public key"
  grep -q -- 'export-options export-minimal' "$script" ||
    fail "Git identity setup does not minimize exported public keys"
}

check_security() {
  local suspicious
  local content_hits

  suspicious=$(find "$ROOT" -path "$ROOT/.git" -prune -o -type f \
    \( -iname '*.pem' -o -iname '*.key' -o -iname '*.p12' -o \
       -iname '*.pfx' -o -iname '*.asc' -o -iname 'id_rsa*' -o \
       -iname 'id_ed25519*' \) -print)
  if [[ -n "$suspicious" ]]; then
    fail "Suspicious credential filenames found:$suspicious"
  else
    ok "No credential-like filenames found"
  fi

  if command -v rg >/dev/null 2>&1; then
    content_hits=$(rg -l --hidden --glob '!.git/**' --glob '!check' \
      '(AKIA[0-9A-Z]{16}|github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9_]{20,}|-----BEGIN (OPENSSH|RSA|EC|DSA) PRIVATE KEY-----)' \
      "$ROOT" 2>/dev/null || true)
    if [[ -n "$content_hits" ]]; then
      fail "Potential credential contents found:$content_hits"
    else
      ok "No common credential signatures found"
    fi
  else
    warn "ripgrep is unavailable; skipped content credential scan"
  fi
}

run_check() {
  case "$1" in
    all)
      check_mise
      check_lazygit
      check_yazi
      check_hypr
      check_git_identity
      check_security
      ;;
    lazygit) check_lazygit ;;
    mise) check_mise ;;
    yazi) check_yazi ;;
    hypr) check_hypr ;;
    git-identity) check_git_identity ;;
    security) check_security ;;
    *) usage; fail "Unknown check: $1" ;;
  esac
}

main() {
  local target

  (($#)) || set -- all
  for target in "$@"; do
    run_check "$target"
  done

  if (( FAILURES > 0 )); then
    printf '\n%d check(s) failed; %d warning(s).\n' "$FAILURES" "$WARNINGS" >&2
    return 1
  fi
  printf '\nAll checks passed with %d warning(s).\n' "$WARNINGS"
}

main "$@"
